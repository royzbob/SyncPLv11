{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SyncPL Trading",
  "version": "1.0.9",
  "identifier": "com.syncpl.trading.dashboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SyncPL Trading Dashboard",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/royzbob/SyncPLv2/releases/latest/download/latest.json",
        "https://raw.githubusercontent.com/royzbob/SyncPLv2/main/updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyMjAwRjM2QzdFMkMwNzEKUldSeHdPTEhOZzhnRW1WK0RDWEZId3RhYnBQd0FGc3R6Zm1uOGd0eFVBaHRiVDVxSWN4eDBwWEIK"
    }
  }
}
