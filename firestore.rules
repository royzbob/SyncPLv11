rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.keys().hasAll(['email']) && request.auth.token.email != null && request.auth.token.email.lower() == '1nathandrew6@gmail.com') ||
        request.auth.uid == '1NathanDrew6@gmail.com' ||
        request.auth.uid == '1nathandrew6@gmail.com'
      );
    }

    // Profiles
    match /users/{userId}/profile/info {
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // Users (base collection query/read)
    match /users/{userId} {
      allow read, write: if isSignedIn();
    }

    // Workspace Rooms
    match /rooms/{roomId} {
      allow read, write: if isSignedIn();
    }

    // Channels
    match /channels/{channelId} {
      allow read, write: if isSignedIn();
    }

    // Chat Messages
    match /chat_messages/{messageId} {
      allow read, write: if isSignedIn();
    }

    // Voice Users
    match /voice_users/{userId} {
      allow read, write: if isSignedIn();
    }

    // Voice Signals (WebRTC signaling)
    match /voice_signals/{signalId} {
      allow read, write: if isSignedIn();
    }

    // P&L Logs
    match /pnl_logs/{logId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        !('userId' in resource.data)
      ));
    }

    // Live Trades
    match /live_trades/{tradeId} {
      allow read, write: if isSignedIn();
    }

    // Trading Rules
    match /trading_rules/{ruleId} {
      allow read, write: if isSignedIn();
    }

    // Friendships and Requests
    match /friendships/{friendshipId} {
      allow read, write: if isSignedIn();
    }

    // Community Payouts
    match /payouts/{payoutId} {
      allow read, write: if isSignedIn();
    }

    // Direct / Private Messages (PMs)
    match /direct_messages/{messageId} {
      allow read, write: if isSignedIn();
    }

    // App Updates & Changelog Broadcasts (App Owner Only)
    match /app_updates/{updateId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
