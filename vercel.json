{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/payment/:match*",
      "destination": "/api/payment/[route]"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/payment/[route]"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
